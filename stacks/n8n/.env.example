# n8n — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env

# Hostname do n8n (deve ser o mesmo do Caddy)
N8N_HOST=n8n.devdaniel.home.arpa

# Banco de dados PostgreSQL interno
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI

# Chave de criptografia para credenciais salvas no n8n
# Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=GERE_COM_openssl_rand_hex_32
