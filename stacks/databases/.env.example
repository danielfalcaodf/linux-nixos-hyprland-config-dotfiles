# Bancos de dados — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# ATENÇÃO: Nunca comite o arquivo .env. Ele está no .gitignore.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI
POSTGRES_DB=postgres

# ── MySQL ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=TROQUE_POR_SENHA_ROOT_AQUI
MYSQL_DB=app
MYSQL_USER=app
MYSQL_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI

# ── SQL Server ─────────────────────────────────────────────────────────────
# Mínimo: 8 chars, maiúsculas, minúsculas, números e símbolos
MSSQL_SA_PASSWORD=Troque@SenhaForte123
# Edição: Developer (grátis para dev), Express (grátis produção limitada)
MSSQL_PID=Developer
